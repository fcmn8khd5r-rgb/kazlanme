---
/**
 * Gabarit commun à toutes les pages : en-tête de document, en-tête visible,
 * pied de page, et les trois comportements du site (état de l'en-tête,
 * révélation au défilement, parallaxe).
 */
import gite from '../data/gite.json';
import { t, ui, route, HTML_LANG, type Lang, type RouteKey } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  title: string;
  description: string;
  /** Page ouverte par un visuel plein cadre : l'en-tête démarre transparent. */
  hasHero?: boolean;
  /** Couleur de la barre d'état sur iPhone — celle du haut de la page. */
  themeColor?: string;
  bodyClass?: string;
}

const {
  lang,
  routeKey,
  title,
  description,
  hasHero = false,
  themeColor = '#12303d',
  bodyClass,
} = Astro.props;

const base = gite.site.url.replace(/\/$/, '');
const canonical = base + route(routeKey, lang);
const ogImage = base + gite.seo.ogImage;

/* Fiche structurée — c'est elle que lisent les moteurs pour afficher le type
   d'hébergement, la capacité et la position. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BedAndBreakfast',
  name: gite.identity.name,
  description: t(gite.seo.pages.home.description, lang),
  url: canonical,
  image: ogImage,
  inLanguage: HTML_LANG[lang],
  address: {
    '@type': 'PostalAddress',
    addressLocality: gite.location.commune,
    postalCode: gite.location.postalCode,
    addressRegion: gite.location.region,
    addressCountry: gite.location.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: gite.location.latitude,
    longitude: gite.location.longitude,
  },
  numberOfRooms: gite.capacity.bedrooms,
  occupancy: { '@type': 'QuantitativeValue', maxValue: gite.capacity.guests },
  petsAllowed: false,
  smokingAllowed: false,
  checkinTime: gite.capacity.checkInFrom,
  checkoutTime: gite.capacity.checkOutBefore,
  starRating: { '@type': 'Rating', ratingValue: 3, bestRating: 5 },
  priceRange: '€€',
};
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover : la page passe sous l'encoche, et c'est
         env(safe-area-inset-*) qui replace le contenu au bon endroit. Sans
         cela, une bande claire reste derrière la barre d'état de l'iPhone. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="fr-FR" href={base + route(routeKey, 'fr')} />
    <link rel="alternate" hreflang="en-GB" href={base + route(routeKey, 'en')} />
    <link rel="alternate" hreflang="x-default" href={base + route(routeKey, 'fr')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={gite.identity.name} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content={gite.seo.twitterCard} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- Les styles de révélation sont conditionnés à cette classe. Sans
         JavaScript, rien ne se cache : la page s'affiche telle quelle. Le
         script est ici, en tête, pour qu'aucun contenu ne clignote. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class={bodyClass} data-hero={hasHero ? 'true' : 'false'}>
    <a class="skip" href="#contenu">{ui('skipToContent', lang)}</a>
    <Header lang={lang} routeKey={routeKey} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      /* --------------------------------------------------------------
         1. État de l'en-tête.
         Transparent tant qu'on est sur le visuel d'ouverture, opaque
         ensuite. Une sentinelle observée vaut mieux qu'un écouteur de
         défilement : le navigateur ne rappelle le code qu'au franchissement.
         -------------------------------------------------------------- */
      const header = document.querySelector<HTMLElement>('.header');
      const overHero = document.body.dataset.hero === 'true';

      if (header) {
        if (!overHero) {
          header.dataset.mode = 'solid';
        } else {
          const sentinel = document.createElement('div');
          sentinel.setAttribute('aria-hidden', 'true');
          sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:60vh;pointer-events:none';
          document.body.prepend(sentinel);

          const watcher = new IntersectionObserver(
            ([entry]) => {
              header.dataset.mode = entry.isIntersecting ? 'over' : 'solid';
            },
            { threshold: 0 },
          );
          watcher.observe(sentinel);
          header.dataset.mode = 'over';
        }
      }

      /* --------------------------------------------------------------
         2. Panneau de navigation mobile.
         -------------------------------------------------------------- */
      const burger = document.querySelector<HTMLButtonElement>('.burger');
      const drawer = document.querySelector<HTMLElement>('.drawer');

      function setDrawer(open: boolean) {
        if (!burger || !drawer) return;
        drawer.dataset.open = String(open);
        burger.setAttribute('aria-expanded', String(open));
        document.body.dataset.locked = String(open);
      }

      burger?.addEventListener('click', () => {
        setDrawer(drawer?.dataset.open !== 'true');
      });

      /* Un lien du panneau pointe vers une ancre : on referme d'abord, sinon
         le défilement se fait sous un panneau resté ouvert. */
      drawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setDrawer(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && drawer?.dataset.open === 'true') setDrawer(false);
      });

      /* --------------------------------------------------------------
         3. Révélation au défilement.
         Un seul observateur pour toute la page. Chaque élément n'est
         déclenché qu'une fois, puis on cesse de l'observer.

         Le seuil est à zéro, volontairement : un seuil en surface rend le
         mécanisme dépendant de la surface visible de la cible, et donc
         fragile dès qu'un style la réduit. Le décalage bas suffit à retarder
         l'apparition jusqu'à ce que l'élément entre franchement dans l'écran.
         -------------------------------------------------------------- */
      const revealables = document.querySelectorAll<HTMLElement>('.reveal');
      const show = (element: Element) => ((element as HTMLElement).dataset.shown = '');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && revealables.length) {
        const shower = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0 },
        );

        for (const element of revealables) {
          /* Déjà à l'écran au chargement : on montre tout de suite, sans
             attendre un défilement qui pourrait ne jamais venir. */
          const box = element.getBoundingClientRect();
          if (box.top < window.innerHeight * 0.92 && box.bottom > 0) {
            show(element);
          } else {
            shower.observe(element);
          }
        }

        const rattraper = (racine: ParentNode) => {
          for (const element of racine.querySelectorAll<HTMLElement>('.reveal')) {
            if (element.dataset.shown !== undefined) continue;
            const box = element.getBoundingClientRect();
            if (box.top < window.innerHeight && box.bottom > 0) {
              show(element);
              shower.unobserve(element);
            }
          }
        };

        /* Filet de sécurité, sans écouteur de défilement.

           Les sections portent `content-visibility: auto` : tant qu'une section
           est ignorée, son contenu n'est pas rendu et l'observateur ne peut pas
           le voir. Le moment exact où elle se met à exister est celui où sa
           taille change — un ResizeObserver s'en aperçoit donc précisément,
           là où un observateur d'intersection peut passer à côté.

           Une passe au chargement complète le dispositif pour ce qui est déjà
           à l'écran. */
        const veille = new ResizeObserver((entries) => {
          for (const entry of entries) rattraper(entry.target);
        });
        document.querySelectorAll('.section').forEach((section) => veille.observe(section));

        addEventListener('load', () => rattraper(document));
      } else {
        revealables.forEach(show);
      }

      /* --------------------------------------------------------------
         4. Parallaxe des bandeaux pleine largeur.

         Aucun écouteur de défilement : une boucle d'animation tourne
         uniquement tant qu'un bandeau est à l'écran, et s'arrête d'elle-même
         sinon. Le seul style écrit est un translate3d — jamais `top`, jamais
         `background-position`. Sous 768 px, rien du tout.
         -------------------------------------------------------------- */
      const bands = [...document.querySelectorAll<HTMLElement>('.band')];
      const wide = window.matchMedia('(min-width: 48.0625em)');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (bands.length && !still.matches) {
        const visible = new Set<HTMLElement>();
        const last = new WeakMap<HTMLElement, number>();
        let running = false;

        const place = (band: HTMLElement) => {
          const media = band.querySelector<HTMLElement>('.band__media');
          if (!media) return;
          const room = Math.max(0, (media.offsetHeight - band.offsetHeight) / 2);
          if (room < 1) return;

          const box = band.getBoundingClientRect();
          /* -1 quand le bandeau entre par le bas, +1 quand il sort par le haut. */
          const progress =
            (box.top + box.height / 2 - window.innerHeight / 2) /
            ((window.innerHeight + box.height) / 2);
          const shift = -Math.max(-1, Math.min(1, progress)) * room;

          /* On n'écrit dans le style que si la valeur a bougé : au repos, la
             boucle ne provoque plus aucune recomposition. */
          if (Math.abs((last.get(media) ?? NaN) - shift) < 0.15) return;
          last.set(media, shift);
          media.style.transform = `translate3d(0, ${shift.toFixed(2)}px, 0)`;
        };

        const frame = () => {
          if (!visible.size || !wide.matches) {
            running = false;
            return;
          }
          for (const band of visible) place(band);
          requestAnimationFrame(frame);
        };

        const start = () => {
          if (running || !visible.size || !wide.matches) return;
          running = true;
          requestAnimationFrame(frame);
        };

        const gate = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const band = entry.target as HTMLElement;
              const media = band.querySelector<HTMLElement>('.band__media');
              if (entry.isIntersecting) {
                visible.add(band);
                /* will-change seulement pendant la traversée de l'écran. */
                if (media && wide.matches) media.style.willChange = 'transform';
              } else {
                visible.delete(band);
                if (media) {
                  media.style.willChange = '';
                  media.style.transform = '';
                  last.delete(media);
                }
              }
            }
            start();
          },
          { rootMargin: '15% 0px' },
        );

        bands.forEach((band) => gate.observe(band));

        /* Passage sous le seuil : on efface tout et on laisse la CSS reprendre. */
        wide.addEventListener('change', () => {
          if (!wide.matches) {
            for (const band of bands) {
              const media = band.querySelector<HTMLElement>('.band__media');
              if (!media) continue;
              media.style.transform = '';
              media.style.willChange = '';
              last.delete(media);
            }
          } else start();
        });

        start();
      }
    </script>
  </body>
</html>
