---
import gite from '../data/gite.json';
import { t } from '../i18n';
import Base from '../layouts/Base.astro';
import AreaPage from '../components/pages/AreaPage.astro';

const lang = 'fr' as const;
const seo = gite.seo.pages.surroundings;
---

<Base
  lang={lang}
  routeKey="surroundings"
  title={t(seo.title, lang)}
  description={t(seo.description, lang)}
  hasHero
>
  <AreaPage lang={lang} />
</Base>
