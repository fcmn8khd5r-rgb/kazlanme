---
import gite from '../../data/gite.json';
import { t } from '../../i18n';
import Base from '../../layouts/Base.astro';
import HomePage from '../../components/pages/HomePage.astro';

const lang = 'en' as const;
const seo = gite.seo.pages.home;
---

<Base
  lang={lang}
  routeKey="home"
  title={t(seo.title, lang)}
  description={t(seo.description, lang)}
  hasHero
>
  <HomePage lang={lang} />
</Base>
