---
import gite from '../../data/gite.json';
import { t } from '../../i18n';
import Base from '../../layouts/Base.astro';
import ThanksPage from '../../components/pages/ThanksPage.astro';

const lang = 'en' as const;
const seo = gite.seo.pages.thanks;
---

<Base
  lang={lang}
  routeKey="thanks"
  title={t(seo.title, lang)}
  description={t(seo.description, lang)}
  themeColor="#fcfcf9"
>
  <ThanksPage lang={lang} />
</Base>
