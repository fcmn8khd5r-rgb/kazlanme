---
/**
 * Icônes dessinées à la main, au trait, dans un seul style.
 * Aucune bibliothèque : onze tracés suffisent, et rien à télécharger.
 * Elles héritent de la couleur du texte et se dimensionnent en CSS.
 */
interface Props {
  name: keyof typeof PATHS;
  class?: string;
}

const PATHS = {
  'arrow-right': '<path d="M3 12h18M14 5l7 7-7 7"/>',
  'arrow-left': '<path d="M21 12H3M10 5l-7 7 7 7"/>',
  'chevron-left': '<path d="M15 5l-7 7 7 7"/>',
  'chevron-right': '<path d="M9 5l7 7-7 7"/>',
  'arrow-down': '<path d="M12 3v18M5 14l7 7 7-7"/>',
  check: '<path d="M4 12.5l5.2 5.2L20 6.9"/>',
  mail: '<path d="M3 6.5h18v11H3z"/><path d="M3 7l9 6.2L21 7"/>',
  phone:
    '<path d="M7.4 3.6h-3a1.4 1.4 0 0 0-1.4 1.5c.5 8.1 6.8 14.4 14.9 14.9a1.4 1.4 0 0 0 1.5-1.4v-3a1.4 1.4 0 0 0-1.1-1.4l-2.7-.6a1.4 1.4 0 0 0-1.4.5l-1 1.2a13 13 0 0 1-5.5-5.5l1.2-1a1.4 1.4 0 0 0 .5-1.4l-.6-2.7a1.4 1.4 0 0 0-1.4-1.1z"/>',
  pin: '<path d="M12 21.5c4.3-4.6 6.5-8.1 6.5-10.7A6.5 6.5 0 0 0 5.5 10.8c0 2.6 2.2 6.1 6.5 10.7z"/><circle cx="12" cy="10.6" r="2.4"/>',
  clock: '<circle cx="12" cy="12" r="8.8"/><path d="M12 6.9V12l3.4 2.2"/>',
  info: '<circle cx="12" cy="12" r="8.8"/><path d="M12 11v5.4M12 7.7v.1"/>',
  calendar:
    '<path d="M4 6.4h16v14H4z"/><path d="M4 10.6h16M8.6 3.6v4M15.4 3.6v4"/>',
} as const;

const { name, class: klass } = Astro.props;
---

<svg
  class={klass}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
