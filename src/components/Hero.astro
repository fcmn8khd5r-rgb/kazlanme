---
/**
 * Visuel d'ouverture, plein écran.
 *
 * DIRECTION ARTISTIQUE — deux cadrages, pas un seul redimensionné.
 * Un écran de téléphone est deux fois plus haut que large ; y plaquer une
 * photo panoramique en `cover` revient à n'en montrer qu'une bande centrale,
 * et le sujet disparaît. Les écrans portrait reçoivent donc une version
 * recadrée en 3/4, tirée de la même photo.
 *
 * C'est pour cela que le <picture> est écrit à la main : le composant
 * <Picture> d'Astro sert le même cadrage à tout le monde.
 */
import gite from '../data/gite.json';
import { t, ui, route, type Lang } from '../i18n';
import { img } from '../lib/images';
import { sourceSets, fallback } from '../lib/srcset';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = route('home', lang);

const paysage = img(gite.hero.image);
const portrait = img(gite.hero.imagePortrait ?? gite.hero.image);

/* Le portrait plafonne à sa largeur réelle (1300 px) : au-delà on agrandirait. */
const sourcesPortrait = await sourceSets(portrait, { widths: [400, 800, 1200], quality: 72 });
const sourcesPaysage = await sourceSets(paysage, { quality: 72 });
const repli = await fallback(paysage, 1200, 72);

const facts = [t(gite.identity.classification, lang), t(gite.capacity.summary, lang)];
---

<section class="hero" id="top">
  <div class="hero__media">
    <picture>
      {
        sourcesPortrait.map((source) => (
          <source media="(orientation: portrait)" type={source.type} srcset={source.srcset} sizes="100vw" />
        ))
      }
      {sourcesPaysage.map((source) => <source type={source.type} srcset={source.srcset} sizes="100vw" />)}
      <img
        src={repli.src}
        width={repli.width}
        height={repli.height}
        alt={t(gite.hero.alt, lang)}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="shell hero__inner">
    <span class="hero__kicker">{t(gite.identity.kicker, lang)}</span>
    <h1 class="hero__title">{gite.identity.name}</h1>
    <p class="hero__tagline">{t(gite.identity.tagline, lang)}</p>

    <ul class="hero__facts">
      {facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <div class="btn-row">
      <a class="btn btn--light" href={`${home}#reserver`}>{ui('book', lang)}</a>
      <a class="btn btn--onDark" href={`${home}#maison`}>{ui('discover', lang)}</a>
    </div>
  </div>

  <span class="hero__scroll" aria-hidden="true">{ui('scroll', lang)}</span>
</section>
